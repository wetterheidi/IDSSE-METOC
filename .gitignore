# # # Abhängigkeiten # # #
# Der häufigste Grund für ein aufgeblähtes Repo bei JS-Projekten.
node_modules/

# # # Build- & Distributions-Ordner # # #
# Falls du Tools wie Webpack, Vite, Parcel, etc. nutzt.
dist/
build/
out/
.parcel-cache/
.vite/

# # # Log-Dateien # # #
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# # # Sensible Umgebungs-Variablen # # #
# NIEMALS API-Keys oder Passwörter committen!
.env
.env.local
.env.*.local

# # # Betriebssystem- & Systemdateien # # #
.DS_Store
Thumbs.db
desktop.ini

# # # IDE- & Editor-Einstellungen # # #
# Damit deine persönlichen Einstellungen nicht die deiner Kollegen überschreiben.
.vscode/
.idea/
*.swp
*.swo